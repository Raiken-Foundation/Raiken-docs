---
import MarketingLayout from '../layouts/MarketingLayout.astro';
---

<MarketingLayout title="Raiken Beta Waitlist">
    <section class="pt-16 pb-12">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <p class="text-brand-400 text-xs font-medium uppercase tracking-wider mb-3">Beta Waitlist</p>
            <h1 class="text-3xl md:text-4xl font-semibold text-white mb-4">Join the Raiken beta</h1>
            <p class="text-gray-400 text-base leading-relaxed">
                Raiken is a local-first CLI that explores your app and generates Playwright tests on request.
                Leave your details and we will reach out with access.
            </p>
        </div>
    </section>

    <section class="pb-16">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="rounded-lg border border-white/10 bg-dark-900/40 p-4">
                <iframe
                    data-tally-src="https://tally.so/r/jaQP7Q?transparentBackground=1"
                    title="Raiken Beta Waitlist"
                    class="w-full h-[680px] rounded-md"
                ></iframe>
            </div>
            <p class="text-xs text-gray-500 mt-4 text-center">
                Having trouble with the embedded form?
                <a class="text-brand-400 hover:text-brand-300" href="https://tally.so/r/jaQP7Q" target="_blank" rel="noreferrer">Open it in a new tab</a>.
            </p>
        </div>
    </section>

    <section class="pb-16 border-t border-white/5">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12">
            <div class="text-center mb-8">
                <h2 class="text-2xl font-semibold text-white mb-2">Where Raiken is headed</h2>
                <p class="text-gray-400 text-sm">Beta testers help shape what ships next. Here is what we are actively working toward.</p>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
                <div class="p-4 rounded-lg bg-dark-800/30 border border-dashed border-white/10">
                    <h3 class="text-sm font-medium text-white mb-1">Multi-page flow capture</h3>
                    <p class="text-gray-500 text-xs leading-relaxed">Navigate across pages with AI-guided loops to capture full user journeys.</p>
                </div>
                <div class="p-4 rounded-lg bg-dark-800/30 border border-dashed border-white/10">
                    <h3 class="text-sm font-medium text-white mb-1">Ticket-aware test updates</h3>
                    <p class="text-gray-500 text-xs leading-relaxed">Jira and GitHub integration so tests stay aligned when requirements change.</p>
                </div>
                <div class="p-4 rounded-lg bg-dark-800/30 border border-dashed border-white/10">
                    <h3 class="text-sm font-medium text-white mb-1">Shared test graph</h3>
                    <p class="text-gray-500 text-xs leading-relaxed">A visual map of test flows your team can build and evolve together.</p>
                </div>
                <div class="p-4 rounded-lg bg-dark-800/30 border border-dashed border-white/10">
                    <h3 class="text-sm font-medium text-white mb-1">Guided auth capture</h3>
                    <p class="text-gray-500 text-xs leading-relaxed">Step-by-step session state capture so protected pages are testable out of the box.</p>
                </div>
            </div>
        </div>
    </section>

    <script async src="https://tally.so/widgets/embed.js"></script>
</MarketingLayout>
